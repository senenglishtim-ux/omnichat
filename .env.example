# ---- required ----
# Public https address of this service. Meta (WhatsApp Cloud, Instagram) and
# Telegram send webhooks here; Instagram downloads media you send from here.
PUBLIC_URL=https://chat.example.com
# Long random strings. Changing ENCRYPTION_KEY makes stored channel secrets unreadable.
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string
# First admin (created on first start only).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---- database (docker-compose sets it for you) ----
# DATABASE_URL=postgres://omnichat:omnichat@localhost:5432/omnichat
# POSTGRES_PASSWORD=omnichat

# ---- optional ----
# PORT=3000
# HOST=0.0.0.0
# Serve under a sub-path behind a proxy, e.g. https://crm.example.com/chat
# BASE_PATH=/chat
# Where media and WhatsApp Web sessions are stored
# DATA_DIR=./data
# MAX_UPLOAD_MB=100
# Who may put /embed/* into an <iframe>: "*" or space-separated origins
# EMBED_ORIGINS=https://crm.example.com
# Allow browser calls to the API from these origins (comma separated)
# CORS_ORIGINS=https://crm.example.com
# LOG_LEVEL=info
# BAILEYS_LOG_LEVEL=error
